# ---- Server ----
PORT=3000
NODE_ENV=development

# Public base URL of THIS API server (no trailing slash).
# Production example: https://api.comeholyspirit.com
PUBLIC_URL=http://localhost:3000

# Comma-separated origins allowed to call the API and open sockets.
# Include your GitHub Pages URL and your domain.
ALLOWED_ORIGINS=http://localhost:3000,https://<you>.github.io,https://comeholyspirit.com,https://www.comeholyspirit.com

# Optional. If set, /auth/owner requires ?key=<value> so nobody else can
# re-link the studio Drive.
ADMIN_KEY=

# ---- Google OAuth 2.0 ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ---- Studio Drive ----
# Set after visiting /auth/owner once. This is the ONE account every
# recording is saved into; guests never sign in to Google.
GOOGLE_REFRESH_TOKEN=

DRIVE_ROOT_FOLDER=Podcast_Studio_Projects

# ---- Bandwidth protection ----
# Server-side "Join parts" is the ONLY feature that moves recording bytes
# through this host (down from Drive, then back up = ~2x the file size).
# Everything else is small JSON. Leave this false on a metered free tier and
# join the numbered parts in your editor instead.
ENABLE_SERVER_JOIN=false

# Refuse a join whose parts total more than this (bytes). Default 2 GB.
JOIN_MAX_BYTES=2147483648

# Rough egress ceiling for join jobs, per process restart (bytes). Default 5 GB.
EGRESS_BUDGET_BYTES=5368709120
